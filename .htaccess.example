# ===================================================
# Takoyaki CMS — きれいなURL用 .htaccess（任意）
# ===================================================
# きれいなURL（/post/slug 等）を使いたい場合、このファイルを
# `.htaccess` にリネームしてください。
#
#   cp .htaccess.example .htaccess
#
# 実ファイル・実ディレクトリ（admin/, login.php, uploads/ など）は
# そのまま配信され、存在しないパスだけ router.php に渡されます。
#
# 注意:
#  - Apache の mod_rewrite が有効である必要があります
#  - サブディレクトリに設置している場合は RewriteBase を調整してください
# ===================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 設置パスに合わせて調整（ドキュメントルート直下なら "/"）
    RewriteBase /takoyaki-cms/

    # 実在するファイル・ディレクトリはそのまま配信
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # それ以外は全て router.php へ
    RewriteRule ^ router.php [L]
</IfModule>
